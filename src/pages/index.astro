<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Siya Bhatkal · Projects & work</title>
<meta name="description" content="CS senior at Texas A&M focused on ML, AI and data visualization. Projects, experience and more.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Didact+Gothic&amp;family=Atkinson+Hyperlegible+Mono:wght@400;500;700&amp;display=swap" rel="stylesheet">
<style is:global>

body{margin:0;background:#E6EDEE}
a{color:#111111}a:hover{color:#444444}
.fx *{transform-box:fill-box}
@keyframes cloud{from{transform:translateX(-300px)}to{transform:translateX(1900px)}}
@keyframes plane{0%{transform:translate(-200px,30px)}100%{transform:translate(1900px,-50px)}}
@keyframes wave{from{transform:translateX(0)}to{transform:translateX(-200px)}}
@keyframes boat{from{transform:translateX(-160px)}to{transform:translateX(1760px)}}
@keyframes rock{0%,100%{transform:rotate(-2deg)}50%{transform:rotate(2deg)}}
@keyframes blink{0%,100%{opacity:.2}50%{opacity:1}}
@keyframes wander{
 0%{left:70%;top:12%}
 14%{left:84%;top:30%}
 28%{left:62%;top:48%}
 42%{left:34%;top:34%}
 56%{left:6%;top:52%}
 70%{left:18%;top:14%}
 84%{left:46%;top:8%}
 100%{left:70%;top:12%}}
@keyframes hover{0%,100%{transform:translateY(0) rotate(-3deg)}50%{transform:translateY(-14px) rotate(3deg)}}
@keyframes legs{0%,100%{transform:rotate(-12deg)}50%{transform:rotate(14deg)}}
@keyframes blinkEye{0%,92%,100%{transform:scaleY(1)}96%{transform:scaleY(.1)}}
@keyframes shadow{0%,100%{transform:scaleX(1);opacity:.18}50%{transform:scaleX(.75);opacity:.1}}
@keyframes hopA{0%{transform:translateY(0) rotate(0) scale(1,1)}15%{transform:translateY(4px) scale(1.12,.88)}45%{transform:translateY(-46px) rotate(-360deg) scale(.95,1.08)}75%{transform:translateY(0) rotate(-360deg) scale(1.1,.9)}100%{transform:translateY(0) rotate(-360deg) scale(1,1)}}
@keyframes hopB{0%{transform:translateY(0) rotate(0) scale(1,1)}15%{transform:translateY(4px) scale(1.12,.88)}45%{transform:translateY(-46px) rotate(360deg) scale(.95,1.08)}75%{transform:translateY(0) rotate(360deg) scale(1.1,.9)}100%{transform:translateY(0) rotate(360deg) scale(1,1)}}
@keyframes popA{0%{opacity:1;transform:rotate(var(--a)) translateY(0) scale(.2)}100%{opacity:0;transform:rotate(var(--a)) translateY(-84px) scale(1)}}
@keyframes popB{0%{opacity:1;transform:rotate(var(--a)) translateY(0) scale(.2)}100%{opacity:0;transform:rotate(var(--a)) translateY(-84px) scale(1)}}
@keyframes bubA{0%{opacity:0;transform:translateY(6px) scale(.85)}100%{opacity:1;transform:none}}
@keyframes bubB{0%{opacity:0;transform:translateY(6px) scale(.85)}100%{opacity:1;transform:none}}
@keyframes bang{0%{opacity:0;transform:translateY(6px) scale(.4)}20%{opacity:1;transform:translateY(-4px) scale(1.2)}70%{opacity:1;transform:none}100%{opacity:0}}
@keyframes cursor{0%,100%{transform:translateY(0)}50%{transform:translateY(3px)}}

.cloudA{animation:cloud 120s linear infinite}
.cloudB{animation:cloud 170s linear infinite}
.plane{animation:plane 40s linear infinite}
.wave{animation:wave 9s linear infinite}
.wave2{animation:wave 14s linear infinite reverse}
.boat{animation:boat 60s linear infinite}
.rock{animation:rock 2.6s ease-in-out infinite;transform-origin:50% 100%}
.beacon{animation:blink 1.6s ease-in-out infinite}

.siya{position:fixed;z-index:30;width:120px;height:210px;margin:0;padding:0;border:0;background:none;cursor:pointer;animation:wander 54s cubic-bezier(.45,.05,.55,.95) infinite}
.siya:hover,.siya:focus-visible,.siya:hover .bod{animation-play-state:paused}
.siya:focus-visible{outline:3px dashed #111;outline-offset:6px;border-radius:12px}
.siya .bod{display:block;width:100%;height:100%;animation:hover 3.6s ease-in-out infinite}
.siya .flip{display:block;width:100%;height:100%;transform-origin:50% 70%}
.siya .leg{animation:legs 1.4s ease-in-out infinite;transform-origin:50% 0%}
.siya .leg2{animation:legs 1.4s ease-in-out infinite reverse;transform-origin:50% 0%}
.siya .eye{animation:blinkEye 4.5s infinite;transform-origin:50% 50%}
.siya .shad{position:absolute;left:30px;bottom:-26px;width:60px;height:10px;border-radius:50%;background:#111;animation:shadow 3.6s ease-in-out infinite}
.siya.jA .flip{animation:hopA .85s cubic-bezier(.3,.7,.3,1)}
.siya.jB .flip{animation:hopB .85s cubic-bezier(.3,.7,.3,1)}
.siya .spark{position:absolute;left:50%;top:62%;width:16px;height:16px;margin:-8px;opacity:0;pointer-events:none}
.siya.jA .spark{animation:popA .7s ease-out}
.siya.jB .spark{animation:popB .7s ease-out}
.siya .bangs{position:absolute;right:-6px;top:58px;opacity:0;font:700 28px/1 'Century Gothic', 'CenturyGothic', 'Didact Gothic', sans-serif;color:#111;pointer-events:none}
.siya.jA .bangs{animation:bang .9s ease-out}
.siya.jB .bangs{animation:bang .9s ease-out}
.bubble{position:absolute;bottom:100%;left:50%;margin:0 0 6px -115px;width:230px;box-sizing:border-box;padding:10px 14px 12px;border:2.5px solid #111;border-radius:10px;background:#FFFFFF;color:#111;font:500 13px/1.4 'Atkinson Hyperlegible Mono', ui-monospace, monospace;text-align:left;box-shadow:4px 4px 0 #111;pointer-events:none}
.bubble .nm{display:block;font:700 11px/1 'Century Gothic', 'CenturyGothic', 'Didact Gothic', sans-serif;letter-spacing:.12em;text-transform:uppercase;margin-bottom:4px}
.bubble .cur{position:absolute;right:10px;bottom:4px;font-size:10px;animation:cursor .8s ease-in-out infinite}
.siya.jA .bubble{animation:bubA .35s ease both}
.siya.jB .bubble{animation:bubB .35s ease both}
@keyframes segIn{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes live{0%,100%{opacity:1}50%{opacity:.2}}
.seg{transform-origin:0 50%;animation:segIn .35s ease both}
.live{animation:live 1.4s ease-in-out infinite}
.card{transition:transform .15s ease, box-shadow .15s ease}
.card:hover{transform:translate(-2px,-2px);box-shadow:8px 8px 0 #111}
.btn{transition:transform .12s ease, box-shadow .12s ease}
.btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 #111}
.btn:active{transform:translate(2px,2px);box-shadow:0 0 0 #111}
@media (max-width: 700px){.siya{width:90px;height:158px}.bubble{width:180px;margin-left:-90px}}
@media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important}.siya{left:78%;top:18%}}

/* ---- night mode ---- */
@keyframes star{0%,100%{opacity:.25}50%{opacity:1}}
@keyframes glowp{0%,100%{opacity:.75}50%{opacity:1}}
.scenebox,.contentbox{transition:filter .7s ease}
.night .scenebox{filter:invert(1) hue-rotate(180deg) brightness(.85)}
.night .contentbox{filter:invert(1) hue-rotate(180deg)}
.night .contentbox img,.night .contentbox .keep{filter:invert(1) hue-rotate(180deg)}
.nightfx{position:fixed;inset:0;z-index:1;pointer-events:none;opacity:0;transition:opacity .8s ease}
.night .nightfx{opacity:1}
.star{animation:star 3s ease-in-out infinite}
.glowp{animation:glowp 2.2s ease-in-out infinite}
.modebtn{width:44px;height:44px;border:2px solid #111;border-radius:999px;background:#FFFFFF;display:inline-flex;align-items:center;justify-content:center;cursor:pointer;padding:0;box-shadow:3px 3px 0 #111;transition:transform .12s ease}
.modebtn:hover{transform:translate(-1px,-1px)}
.modebtn:focus-visible{outline:3px dashed #111;outline-offset:3px}

.modebtn .ic-sun{display:none}
.night .modebtn .ic-moon{display:none}
.night .modebtn .ic-sun{display:inline}
.skip{position:absolute;left:-9999px;top:0}
.skip:focus{left:16px;top:16px;z-index:100;background:#fff;padding:10px 14px;border:2px solid #111;border-radius:10px}
@media (max-width: 640px){h1{font-size:48px !important}header nav{flex-wrap:nowrap !important;gap:0 !important;padding:4px !important}header nav a{padding:8px 9px !important;font-size:13px;white-space:nowrap;min-height:40px}header nav a svg{display:none}header{gap:10px !important}}
</style>
<script is:inline>try{if(localStorage.getItem('siya-night')==='1')document.documentElement.classList.add('pre-night')}catch(e){}</script>
