# Copy this file to .env for local testing. Never commit the real .env.
# On Vercel, add these under Project → Settings → Environment Variables.
LASTFM_API_KEY=your_lastfm_api_key_here
LASTFM_USER=siya_bhatkal

# Workouts (Apple Health via iPhone Shortcut)
# Vercel fills in the KV_ ones automatically when you connect an Upstash Redis database.
KV_REST_API_URL=
KV_REST_API_TOKEN=
WORKOUT_TOKEN=make_up_a_long_random_password
SITE_TIMEZONE=America/Chicago
